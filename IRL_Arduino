int activeChord = -1; 

// Βοηθητική συνάρτηση - Τώρα ανάβει και τα ΔΥΟ LED μαζί με τον ήχο
void playTone(int note, int duration) {
  if (note > 0) {
    digitalWrite(led1, HIGH); // Ανάβει το LED1
    digitalWrite(led2, HIGH); // Ανάβει και το LED2
    tone(buzzer1, note, duration);
    tone(buzzer2, note, duration);
  }
  delay(duration);
  
  noTone(buzzer1);
  noTone(buzzer2);
  digitalWrite(led1, LOW);  // Σβήνει το LED1
  digitalWrite(led2, LOW);  // Σβήνει και το LED2
  delay(duration * beatseparationconstant);
}

// Η κύρια συνάρτηση που παίζει το τραγούδι
void playSong() {
  int notelength;
  int size;

  // 1. INTRO
  size = sizeof(song1_intro_melody) / sizeof(int);
  for (int i = 0; i < size; i++) {
    notelength = beatlength * song1_intro_rhythmn[i];
    playTone(song1_intro_melody[i], notelength);
  }

  // 2. VERSE
  size = sizeof(song1_verse1_melody) / sizeof(int);
  for (int i = 0; i < size; i++) {
    notelength = beatlength * 2 * song1_verse1_rhythmn[i];
    playTone(song1_verse1_melody[i], notelength);
  }

  // 3. CHORUS
  size = sizeof(song1_chorus_melody) / sizeof(int);
  for (int i = 0; i < size; i++) {
    notelength = beatlength * song1_chorus_rhythmn[i];
    playTone(song1_chorus_melody[i], notelength);
  }
}

int getChordIndex(char key) {
  switch (key) {
    case '1': return 0;  // Am
    case '2': return 1;  // C
    case '3': return 2;  // G7
    case 'A': return 3;  // Em
    case '4': return 4;  // G
    case '5': return 5;  // D7
    case '6': return 6;  // Bm
    case 'B': return 7;  // D
    case '7': return 8;  // A7
    case '8': return 9;  // F#m
    case '9': return 10; // A
    case 'C': return 11; // E7
    case '*': return 12; // Dm
    case '0': return 13; // F
    case '#': return 14; // C7
    case 'D': return 15; // 16ο Κουμπί -> Ολόκληρο το RickRoll
    default:  return -1;
  }
}

void setup() {
  pinMode(buzzer1, OUTPUT);
  pinMode(buzzer2, OUTPUT);
  
  pinMode(led1, OUTPUT);
  pinMode(led2, OUTPUT);
  
  pinMode(switch1, INPUT_PULLUP);
  pinMode(switch2, INPUT_PULLUP);
  
  Serial.begin(9600);
}

void loop() {
  char key = customKeypad.getKey();
  
  if (key != NO_KEY) {
    activeChord = getChordIndex(key);
    
    // Αν πατηθεί το 'D', εκτελείται ολόκληρο το τραγούδι
    if (activeChord == 15) {
      playSong();
      activeChord = -1; 
    }
  }

  // Έλεγχος αν οι διακόπτες είναι πατημένοι (LOW)
  bool s1_pressed = (digitalRead(switch1) == LOW);
  bool s2_pressed = (digitalRead(switch2) == LOW);
  
  // --- ΕΛΕΓΧΟΣ LED (Όταν πατάς τους διακόπτες χειροκίνητα) ---
  if (s1_pressed) {
    digitalWrite(led1, HIGH);
  } else {
    digitalWrite(led1, LOW);
  }

  if (s2_pressed) {
    digitalWrite(led2, HIGH);
  } else {
    digitalWrite(led2, LOW);
  }

  // Έλεγχος αν το keypad είναι πατημένο/κρατημένο
  bool keypad_pressed = (customKeypad.getState() == PRESSED || customKeypad.getState() == HOLD);

  // Λειτουργία Συγχορδιών (για τα κουμπιά 1-15)
  if (keypad_pressed && (s1_pressed || s2_pressed) && activeChord >= 0 && activeChord <= 14) {
    
    if (s1_pressed) {
      tone(buzzer1, chords[activeChord].note1);
    } else {
      noTone(buzzer1);
    }
    
    if (s2_pressed) {
      tone(buzzer2, chords[activeChord].note2);
    } else {
      noTone(buzzer2);
    }
    
  } else {
    if (activeChord != 15) { 
      noTone(buzzer1);
      noTone(buzzer2);
    }
    
    if (customKeypad.getState() == RELEASED) {
      activeChord = -1;
    }
  }
}
